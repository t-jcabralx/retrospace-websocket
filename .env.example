# The website's address: this server asks it, signed, who each person is and what they may do (POST <SITE_URL>/api/rt/authorize).
SITE_URL=https://retrospace-mauve.vercel.app
# The SAME value as RT_SECRET on the website. It signs the tickets this server checks and the questions it asks the website.
RT_SECRET=
# The SAME Upstash database as the website: the bus between the two.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Site addresses allowed to open a connection, comma separated (default: SITE_URL's address).
ALLOWED_ORIGINS=https://retrospace-mauve.vercel.app
PORT=8080
MAX_CONNECTIONS=5000
# Longest one connection lives, in milliseconds; the browser then gets a new ticket from the website, which checks access again.
RT_WS_MAX_MS=270000
